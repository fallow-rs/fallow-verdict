{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "fallow-verdict-check/v1"
    },
    "kind": {
      "type": "string"
    },
    "target": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "finding",
            "path"
          ]
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "value"
      ]
    },
    "dry_run": {
      "type": "boolean"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "cleared",
        "stands",
        "needs-person",
        "error",
        "estimated"
      ]
    },
    "exit_code": {
      "anyOf": [
        {
          "type": "number",
          "const": 0
        },
        {
          "type": "number",
          "const": 1
        },
        {
          "type": "number",
          "const": 2
        },
        {
          "type": "number",
          "const": 3
        }
      ]
    },
    "estimate": {
      "type": "object",
      "properties": {
        "input_tokens": {
          "type": "number"
        },
        "usd": {
          "type": "number"
        }
      },
      "required": [
        "input_tokens",
        "usd"
      ]
    },
    "usage": {
      "type": "object",
      "properties": {
        "input_tokens": {
          "type": "number"
        },
        "cost_usd": {
          "type": "number"
        }
      },
      "required": [
        "input_tokens",
        "cost_usd"
      ]
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "resolved",
              "closed",
              "judged",
              "ambiguous",
              "not-assessed",
              "error"
            ]
          },
          "finding_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "stored_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "locations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "line": {
                  "type": "number"
                },
                "col": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "path",
                "line",
                "col"
              ]
            }
          },
          "category": {
            "type": [
              "string",
              "null"
            ]
          },
          "verdict": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "survivor",
                  "dismissed",
                  "needs-human-review"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "rule": {
            "type": [
              "string",
              "null"
            ]
          },
          "confidence": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "reason": {
            "type": "string"
          },
          "matches": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "error": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string"
                  },
                  "message": {
                    "type": "string"
                  }
                },
                "required": [
                  "code",
                  "message"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "status",
          "finding_id",
          "stored_id",
          "locations",
          "category",
          "verdict",
          "rule",
          "confidence",
          "reason",
          "matches",
          "error"
        ]
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "rerun-check",
              "close",
              "scan"
            ]
          },
          "auto_fixable": {
            "type": "boolean",
            "const": false
          },
          "description": {
            "type": "string"
          },
          "command": {
            "type": "string"
          },
          "finding_id": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "auto_fixable",
          "description",
          "command"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "kind",
    "target",
    "dry_run",
    "outcome",
    "exit_code",
    "estimate",
    "usage",
    "results",
    "actions"
  ]
}
