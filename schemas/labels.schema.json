{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "fallow-verdict-labels/v1"
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "finding_id": {
            "type": "string",
            "minLength": 1
          },
          "expected": {
            "type": "string",
            "enum": [
              "vulnerable",
              "safe"
            ]
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "finding_id",
          "expected"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "labels"
  ]
}
