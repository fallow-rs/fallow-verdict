{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "fallow-verdict-record/v1"
    },
    "finding_id": {
      "type": "string",
      "minLength": 1
    },
    "path": {
      "type": "string"
    },
    "line": {
      "type": "number"
    },
    "category": {
      "type": [
        "string",
        "null"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "judged",
        "error",
        "resolved"
      ]
    },
    "firstSeenAt": {
      "type": "string"
    },
    "lastSeenAt": {
      "type": "string"
    },
    "fingerprint": {
      "type": [
        "string",
        "null"
      ]
    },
    "questionSet": {
      "type": [
        "string",
        "null"
      ]
    },
    "engine": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "answers": {
      "default": null,
      "anyOf": [
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "noul"
                  },
                  "probability": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "required": [
                  "type",
                  "probability"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "choice"
                  },
                  "choice": {
                    "type": "string"
                  },
                  "probabilities": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  },
                  "confidence": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "required": [
                  "type",
                  "choice",
                  "probabilities",
                  "confidence"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "score"
                  },
                  "score": {
                    "type": "number"
                  },
                  "probabilities": {
                    "type": "array",
                    "items": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  },
                  "confidence": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "required": [
                  "type",
                  "score",
                  "probabilities",
                  "confidence"
                ]
              }
            ]
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "decision": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "verdict": {
              "type": "string",
              "enum": [
                "survivor",
                "dismissed",
                "needs-human-review"
              ]
            },
            "rule": {
              "type": "string"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "probabilities": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "number"
              }
            },
            "impact": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "score": {
                      "type": "number"
                    },
                    "label": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "score",
                    "label"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "fixDirection": {
              "type": [
                "string",
                "null"
              ]
            },
            "dismissalReason": {
              "type": [
                "string",
                "null"
              ]
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "verdict",
            "rule",
            "confidence",
            "probabilities",
            "impact",
            "fixDirection",
            "dismissalReason",
            "reason"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "truncated": {
              "type": "boolean"
            },
            "windows": {
              "type": "number"
            },
            "hasSource": {
              "type": "boolean"
            },
            "hasTrace": {
              "type": "boolean"
            }
          },
          "required": [
            "truncated",
            "windows",
            "hasSource",
            "hasTrace"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "usage": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "inputTokens": {
              "type": "number"
            },
            "costUsd": {
              "type": "number"
            },
            "latencyMs": {
              "type": "number"
            }
          },
          "required": [
            "inputTokens",
            "costUsd",
            "latencyMs"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "code",
            "message"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "at": {
            "type": "string"
          },
          "runId": {
            "type": "string"
          },
          "verdict": {
            "type": "string",
            "enum": [
              "survivor",
              "dismissed",
              "needs-human-review"
            ]
          },
          "rule": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "fingerprint": {
            "type": "string"
          },
          "model": {
            "type": "string"
          }
        },
        "required": [
          "at",
          "runId",
          "verdict",
          "rule",
          "confidence",
          "fingerprint",
          "model"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "finding_id",
    "path",
    "line",
    "category",
    "severity",
    "status",
    "firstSeenAt",
    "lastSeenAt",
    "fingerprint",
    "questionSet",
    "decision",
    "evidence",
    "usage",
    "error",
    "history"
  ]
}
