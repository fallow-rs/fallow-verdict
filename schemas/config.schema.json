{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "root": {
      "default": ".",
      "type": "string"
    },
    "dataDir": {
      "default": ".fallow-verdict",
      "type": "string"
    },
    "fallow": {
      "default": {},
      "type": "object",
      "properties": {
        "binary": {
          "type": "string"
        },
        "timeoutMs": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "engine": {
      "default": {},
      "type": "object",
      "properties": {
        "model": {
          "default": "jev-latest",
          "type": "string"
        },
        "baseUrl": {
          "type": "string",
          "format": "uri"
        },
        "apiKeyEnv": {
          "default": "TYPESAFE_API_KEY",
          "type": "string"
        },
        "timeoutMs": {
          "default": 10000,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "concurrency": {
          "default": 8,
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        }
      },
      "additionalProperties": false
    },
    "packet": {
      "default": {},
      "type": "object",
      "properties": {
        "radius": {
          "default": 20,
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "maxStateTokens": {
          "default": 28000,
          "type": "integer",
          "minimum": 1000,
          "maximum": 32000
        },
        "blind": {
          "default": false,
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "policy": {
      "default": {},
      "type": "object",
      "properties": {
        "survivorMinExploitable": {
          "default": 0.7,
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "dismissMaxExploitable": {
          "default": {},
          "type": "object",
          "properties": {
            "high": {
              "default": 0.05,
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "medium": {
              "default": 0.1,
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "low": {
              "default": 0.15,
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "dismissMinReasonStrength": {
          "default": 0.8,
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "tamperingMax": {
          "default": 0.5,
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "failOn": {
      "default": "survivor",
      "type": "string",
      "enum": [
        "off",
        "survivor",
        "needs-human-review"
      ]
    }
  },
  "additionalProperties": false
}
